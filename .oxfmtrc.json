{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "sortImports": true,
  "sortPackageJson": true,
  "ignorePatterns": [
    "ui/dist/**",
    "tools/oxlint/anti-slop/**",
    "test/fixtures/**",
    ".wrangler/**",
    "worker-configuration.d.ts",
    "pnpm-lock.yaml",
    "README.md",
    "DESIGN.md"
  ]
}
