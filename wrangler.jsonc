{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zentry",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "preview_urls": false,
  // Placeholders: the real values live in wrangler.production.jsonc, which is
  // not committed. See README.md, Deploy.
  // The UI hostname sits behind Cloudflare Access; the ingest hostname must not.
  "routes": [
    { "pattern": "ingest.zentry.example.com", "custom_domain": true },
    { "pattern": "zentry.example.com", "custom_domain": true },
  ],
  "assets": {
    "directory": "./ui/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Every request reaches the Worker first, so the ingest hostname can refuse
    // the UI. The Worker hands UI paths back to the assets binding itself.
    "run_worker_first": true,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "zentry",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [{ "binding": "BLOBS", "bucket_name": "zentry-blobs" }],
  "queues": {
    "producers": [{ "binding": "EVENTS_Q", "queue": "zentry-events" }],
    "consumers": [
      {
        "queue": "zentry-events",
        "max_batch_size": 100,
        "max_batch_timeout": 5,
        "max_concurrency": 1,
        "max_retries": 5,
        "dead_letter_queue": "zentry-events-dlq",
      },
    ],
  },
  "ratelimits": [
    { "name": "INGEST_RL", "namespace_id": "1001", "simple": { "limit": 600, "period": 60 } },
  ],
  "triggers": { "crons": ["17 3 * * *"] },
  // Without this, `wrangler dev` presents requests as if they came to the
  // first route above, and the Worker would treat everything as ingest-only.
  "dev": { "port": 8787, "host": "localhost:8787", "upstream_protocol": "http" },
  "observability": { "enabled": true },
  "vars": {
    "INGEST_HOST": "ingest.zentry.example.com",
    "ACCESS_TEAM_DOMAIN": "your-team.cloudflareaccess.com",
    "ACCESS_AUD": "replace-with-the-access-application-audience-tag",
    "RETENTION_DAYS": "90",
    "MAX_STORED_PER_GROUP_HOUR": "100",
    // Local development only: honoured when the request host is localhost.
    "DEV_USER_EMAIL": "",
  },
}
