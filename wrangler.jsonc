{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zentry",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "preview_urls": false,
  // Replace both hostnames with your own before the first deploy.
  "routes": [
    { "pattern": "ingest.zentry.example.com", "custom_domain": true },
    { "pattern": "zentry.example.com", "custom_domain": true },
  ],
  "assets": {
    "directory": "./ui/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "zentry",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [{ "binding": "BLOBS", "bucket_name": "zentry-blobs" }],
  "queues": {
    "producers": [{ "binding": "EVENTS_Q", "queue": "zentry-events" }],
    "consumers": [
      {
        "queue": "zentry-events",
        "max_batch_size": 100,
        "max_batch_timeout": 5,
        "max_concurrency": 1,
        "max_retries": 5,
        "dead_letter_queue": "zentry-events-dlq",
      },
    ],
  },
  "ratelimits": [
    { "name": "INGEST_RL", "namespace_id": "1001", "simple": { "limit": 600, "period": 60 } },
  ],
  "triggers": { "crons": ["17 3 * * *"] },
  "observability": { "enabled": true },
  "vars": {
    "INGEST_HOST": "ingest.zentry.example.com",
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    "RETENTION_DAYS": "90",
    "MAX_STORED_PER_GROUP_HOUR": "100",
    // Local development only: honoured when the request host is localhost.
    "DEV_USER_EMAIL": "",
  },
}
