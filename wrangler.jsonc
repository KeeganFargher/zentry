{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zentry",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "preview_urls": false,
  // Placeholders: the real values live in wrangler.production.jsonc, which is
  // not committed. See README.md, Deploy.
  // The UI hostname sits behind Cloudflare Access; the ingest hostname must not.
  "routes": [
    { "pattern": "ingest.zentry.example.com", "custom_domain": true },
    { "pattern": "zentry.example.com", "custom_domain": true },
  ],
  "assets": {
    "directory": "./ui/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Every request reaches the Worker first, so the ingest hostname can refuse
    // the UI. The Worker hands UI paths back to the assets binding itself.
    "run_worker_first": true,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "zentry",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [{ "binding": "BLOBS", "bucket_name": "zentry-blobs" }],
  // Notification email through Cloudflare Email Service (DESIGN.md §18). It
  // sends only once the sender's domain is onboarded; until EMAIL_FROM is set
  // below, nothing is sent at all.
  "services": [{ "binding": "UPTIME_PROBE", "service": "zentry-uptime-probe" }],
  "send_email": [{ "name": "EMAIL" }],
  // Signs unsubscribe links: `wrangler secret put EMAIL_SIGNING_KEY`, and a
  // line in .dev.vars for local development.
  "secrets": { "required": ["EMAIL_SIGNING_KEY"] },
  "queues": {
    "producers": [
      { "binding": "UPTIME_Q", "queue": "zentry-uptime" },
      { "binding": "EVENTS_Q", "queue": "zentry-events" },
      { "binding": "NOTIFY_Q", "queue": "zentry-notify" },
    ],
    "consumers": [
      {
        "queue": "zentry-uptime",
        "max_batch_size": 4,
        "max_batch_timeout": 1,
        "max_concurrency": 10,
        "max_retries": 3,
        "dead_letter_queue": "zentry-uptime-dlq",
      },
      {
        "queue": "zentry-events",
        "max_batch_size": 100,
        "max_batch_timeout": 5,
        "max_concurrency": 1,
        "max_retries": 5,
        "dead_letter_queue": "zentry-events-dlq",
      },
      // Notifications (DESIGN.md §18). One batch at a time, so two deliveries
      // never handle the same outbox row or digest window together.
      {
        "queue": "zentry-notify",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_concurrency": 1,
        "max_retries": 5,
        "dead_letter_queue": "zentry-notify-dlq",
      },
    ],
  },
  "ratelimits": [
    {
      "name": "MONITOR_PREVIEW_RL",
      "namespace_id": "1004",
      "simple": { "limit": 10, "period": 60 },
    },
    // Per project, monitor slug and environment: Sentry's default of six
    // check-ins a minute per monitor environment (options/defaults.py).
    { "name": "CHECK_IN_RL", "namespace_id": "1003", "simple": { "limit": 6, "period": 60 } },
    { "name": "INGEST_RL", "namespace_id": "1001", "simple": { "limit": 600, "period": 60 } },
    // The mobile app's API on the public ingest host, per client address: the
    // pairing exchange and every device-token lookup cost a D1 read, and no
    // Access sits in front of them (DESIGN.md §19.1). A phone makes a few
    // requests a minute; a scan of codes or tokens makes far more.
    { "name": "APP_API_RL", "namespace_id": "1002", "simple": { "limit": 120, "period": 60 } },
  ],
  // Daily retention; the hourly spike thresholds and outbox sweep; the weekly
  // report on Saturdays. src/worker.ts tells them apart by the cron string.
  "triggers": { "crons": ["* * * * *", "17 3 * * *", "3 * * * *", "0 12 * * 6"] },
  // Without this, `wrangler dev` presents requests as if they came to the
  // first route above, and the Worker would treat everything as ingest-only.
  "dev": { "port": 8787, "host": "localhost:8787", "upstream_protocol": "http" },
  // Workers Logs bills every invocation's log beyond 20 million a month
  // ($0.60 per million), so a request flood would cost twice: once for the
  // requests, once for their logs. Sampling a tenth keeps errors visible while
  // bounding that second cost. Raise it while debugging.
  "observability": { "enabled": true, "head_sampling_rate": 0.1 },
  "vars": {
    "UPTIME_ORIGINS": "",
    // Only the end-to-end suite sets this, to its loopback shop fixture.
    "UPTIME_FIXTURE_ORIGIN": "",
    "INGEST_HOST": "ingest.zentry.example.com",
    "ACCESS_TEAM_DOMAIN": "your-team.cloudflareaccess.com",
    "ACCESS_AUD": "replace-with-the-access-application-audience-tag",
    "RETENTION_DAYS": "90",
    "MAX_STORED_PER_GROUP_HOUR": "100",
    // The UI's origin, for links in emails.
    "MONITOR_ALERTS_PAUSED": "0",
    "MONITOR_BELOW_COUNT_PAGING": "0",
    "APP_URL": "https://zentry.example.com",
    // The origin the mobile app calls, which goes in the pairing QR code. It
    // must be a host Cloudflare Access does not guard: the ingest host, where
    // the API accepts device tokens only (DESIGN.md §19).
    "MOBILE_API_URL": "https://ingest.zentry.example.com",
    // The notification sender, such as "Zentry <alerts@zentry.example.com>",
    // on a domain onboarded to Email Sending. Empty sends nothing.
    "EMAIL_FROM": "",
    // Local development only: honoured when the request host is localhost.
    "DEV_USER_EMAIL": "",
  },
}
